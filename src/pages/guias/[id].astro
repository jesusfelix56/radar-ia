---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AdUnit from '../../components/AdUnit.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import AmazonPicks from '../../components/AmazonPicks.astro';
import ToolCard from '../../components/ToolCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import TryButton from '../../components/TryButton.astro';
import { site } from '../../site.config';
import { formatDate, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const data = guide.data;

const relatedTools = (
  await Promise.all(data.relatedTools.map((id) => getEntry('tools', id)))
).filter((tool) => tool !== undefined);

const primaryTool = relatedTools[0];
const url = `${site.url}/guias/${guide.id}`;
const minutes = readingTime(guide.body ?? '');
const howToSteps = headings
  .filter((heading) => heading.depth === 2)
  .map((heading, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: heading.text,
    url: `${url}#${heading.slug}`,
  }));

const schema: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    url,
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    inLanguage: site.locale,
    author: { '@type': 'Organization', name: site.author },
    publisher: { '@id': `${site.url}/#organization` },
    keywords: data.tags.join(', '),
    mainEntityOfPage: url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: `${site.url}/guias` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];

if (howToSteps.length > 1 && (data.category === 'Guía' || data.category === 'Tutorial')) {
  schema.push({
    '@type': 'HowTo',
    name: data.title,
    description: data.description,
    inLanguage: site.locale,
    step: howToSteps,
  });
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
  schema={schema}
>
  <article class="container-page py-10">
    <Breadcrumbs items={[{ label: 'Guías', href: '/guias' }, { label: data.category }]} />

    <header class="mt-6 max-w-3xl border-b border-ink-800 pb-8">
      <span class="text-xs font-semibold tracking-wide text-accent-400 uppercase">
        {data.category}
      </span>
      <h1 class="mt-3 font-display text-4xl leading-tight font-bold text-white md:text-5xl">
        {data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">{data.description}</p>
      <p class="mt-5 text-xs text-slate-500">
        {formatDate(data.pubDate)}
        {data.updatedDate && ` · Actualizado el ${formatDate(data.updatedDate)}`}
        · {minutes} min de lectura · Por {site.author}
      </p>
    </header>

    {
      primaryTool && (
        <aside class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-brand-400/30 bg-brand-400/[0.07] p-5">
          <div>
            <p class="text-xs font-semibold tracking-wide text-brand-300 uppercase">Herramienta de esta guía</p>
            <p class="mt-1 font-display text-lg font-semibold text-white">{primaryTool.data.name}</p>
            <p class="mt-1 max-w-xl text-sm text-slate-400">{primaryTool.data.tagline}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href={`/herramientas/${primaryTool.id}`}
              class="rounded-lg border border-ink-600 px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-brand-400/60 hover:text-white"
            >
              Leer análisis
            </a>
            <TryButton tool={primaryTool} />
          </div>
        </aside>
      )
    }

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        <div
          data-article-body
          class="prose prose-invert prose-radar max-w-none prose-headings:text-white prose-a:text-brand-300 prose-strong:text-white"
        >
          <Content />
        </div>

        <InArticleAd />

        {data.amazonPicks.length > 0 && <AmazonPicks picks={data.amazonPicks} compact />}

        {
          relatedTools.length > 0 && (
            <section class="mt-14">
              <h2 class="font-display text-2xl font-bold text-white">
                Herramientas mencionadas en esta guía
              </h2>
              <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {relatedTools.map((tool) => (
                  <ToolCard tool={tool} />
                ))}
              </div>
            </section>
          )
        }

        <div class="mt-14">
          <Newsletter compact />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <TableOfContents headings={headings} />
        <AdUnit adSlot="sidebar" format="rectangle" minHeight={250} class="my-0" />
      </aside>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <div class="container-page flex min-h-[55vh] max-w-2xl flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-7xl font-bold text-brand-400">404</p>
    <h1 class="mt-6 font-display text-3xl font-bold text-white">Esta página no existe</h1>
    <p class="mt-4 text-slate-400">
      Puede que el enlace esté mal escrito o que hayamos movido el contenido. Estos son los sitios
      donde suele estar lo que buscas.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/herramientas"
        class="rounded-lg bg-brand-400 px-5 py-2.5 text-sm font-semibold text-ink-950 transition hover:bg-brand-300"
      >
        Ver todas las herramientas
      </a>
      <a
        href="/guias"
        class="rounded-lg border border-ink-600 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-brand-400/60 hover:text-white"
      >
        Leer las guías
      </a>
      <a
        href="/"
        class="rounded-lg border border-ink-600 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-brand-400/60 hover:text-white"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>

---
import TextPage from '../layouts/TextPage.astro';
import { forms, site } from '../site.config';

const hasEndpoint = Boolean(forms.contact);
---

<TextPage
  title="Contacto"
  description="Escríbenos para corregir un dato, proponer una herramienta o consultar sobre colaboraciones."
  heading="Contacto"
  intro="Leemos todo. Respondemos a casi todo, normalmente en menos de una semana."
  breadcrumbs={[{ label: 'Contacto' }]}
>
  <h2>Por correo</h2>
  <p>
    La vía más rápida es escribir a <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>

  <h2>Para qué sí</h2>
  <ul>
    <li>Corregir un dato o un precio desactualizado (lo agradecemos de verdad).</li>
    <li>Proponer una herramienta para analizar.</li>
    <li>Discrepar con una nota y explicarnos por qué.</li>
    <li>Consultas sobre uso de nuestro contenido.</li>
  </ul>

  <h2>Para qué no</h2>
  <p>
    No publicamos posts patrocinados, no vendemos enlaces y no aceptamos artículos de invitados con
    enlaces incrustados. Si tu correo va de eso, te ahorramos el tiempo: la respuesta es no.
  </p>

  <h2>Formulario</h2>
  {
    !hasEndpoint && (
      <p class="text-sm text-slate-400">
        Al enviar se abre tu cliente de correo con el mensaje listo. Si prefieres un envío sin salir
        de la página, conecta Formspree, Netlify Forms o Web3Forms en <code>PUBLIC_FORM_URL</code>.
      </p>
    )
  }

  <form
    id="form-contacto"
    method="post"
    action={hasEndpoint ? forms.contact : undefined}
    data-mailto={hasEndpoint ? undefined : site.email}
    class="not-prose mt-6 space-y-4 rounded-2xl border border-ink-700 bg-ink-900/50 p-6"
  >
    <div>
      <label for="nombre" class="mb-1.5 block text-sm font-medium text-white">Nombre</label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white focus:border-brand-400 focus:outline-none"
      />
    </div>

    <div>
      <label for="correo" class="mb-1.5 block text-sm font-medium text-white">
        Correo electrónico
      </label>
      <input
        id="correo"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white focus:border-brand-400 focus:outline-none"
      />
    </div>

    <div>
      <label for="mensaje" class="mb-1.5 block text-sm font-medium text-white">Mensaje</label>
      <textarea
        id="mensaje"
        name="mensaje"
        rows="5"
        required
        class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white focus:border-brand-400 focus:outline-none"
      ></textarea>
    </div>

    <label class="flex items-start gap-2.5 text-sm text-slate-300">
      <input
        type="checkbox"
        name="privacidad"
        required
        class="mt-0.5 h-4 w-4 rounded border-ink-600 bg-ink-950 accent-brand-400"
      />
      He leído y acepto la{' '}
      <a href="/legal/privacidad" class="text-brand-300 underline">política de privacidad</a>.
    </label>

    <button
      type="submit"
      class="rounded-lg bg-brand-400 px-5 py-2.5 text-sm font-semibold text-ink-950 transition hover:bg-brand-300"
    >
      Enviar mensaje
    </button>
  </form>

  {
    !hasEndpoint && (
      <script is:inline>
        (() => {
          const form = document.getElementById('form-contacto');
          const to = form?.getAttribute('data-mailto');
          if (!form || !to) return;
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const nombre = String(data.get('nombre') || '').trim();
            const email = String(data.get('email') || '').trim();
            const mensaje = String(data.get('mensaje') || '').trim();
            const subject = encodeURIComponent(`Contacto web: ${nombre}`);
            const body = encodeURIComponent(`Nombre: ${nombre}\nCorreo: ${email}\n\n${mensaje}`);
            window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
          });
        })();
      </script>
    )
  }
</TextPage>

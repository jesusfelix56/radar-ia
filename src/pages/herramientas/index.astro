---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdUnit from '../../components/AdUnit.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site } from '../../site.config';

const tools = (await getCollection('tools', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.rating - a.data.rating,
);
const categories = [...new Set(tools.map((tool) => tool.data.category))].sort();
---

<BaseLayout
  title="Todas las herramientas de IA analizadas"
  description="Buscador y filtros de todas las herramientas de inteligencia artificial que hemos probado: nota, categoría, precio y plan gratuito."
  schema={[
    {
      '@type': 'ItemList',
      name: 'Herramientas de IA analizadas',
      numberOfItems: tools.length,
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${site.url}/herramientas/${tool.id}`,
        name: tool.data.name,
      })),
    },
  ]}
>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ label: 'Herramientas' }]} />

    <h1 class="mt-5 font-display text-4xl font-bold text-white">Todas las herramientas</h1>
    <p class="mt-3 max-w-2xl text-slate-400">
      {tools.length} análisis con pruebas propias. Filtra por lo que necesitas y ordena por lo que te
      importa.
    </p>

    <div class="mt-8 rounded-2xl border border-ink-700 bg-ink-900/50 p-5">
      <div class="grid gap-4 md:grid-cols-[1.5fr_1fr_1fr]">
        <div>
          <label for="buscador" class="mb-1.5 block text-xs font-medium text-slate-400">
            Buscar
          </label>
          <input
            id="buscador"
            type="search"
            placeholder="Nombre, categoría o para qué sirve…"
            class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-brand-400 focus:outline-none"
          />
        </div>

        <div>
          <label for="filtro-categoria" class="mb-1.5 block text-xs font-medium text-slate-400">
            Categoría
          </label>
          <select
            id="filtro-categoria"
            class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white focus:border-brand-400 focus:outline-none"
          >
            <option value="">Todas</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </div>

        <div>
          <label for="orden" class="mb-1.5 block text-xs font-medium text-slate-400">Ordenar</label>
          <select
            id="orden"
            class="w-full rounded-lg border border-ink-600 bg-ink-950 px-4 py-2.5 text-sm text-white focus:border-brand-400 focus:outline-none"
          >
            <option value="rating">Mejor nota</option>
            <option value="price">Precio más bajo</option>
            <option value="name">Nombre (A-Z)</option>
            <option value="recent">Más recientes</option>
          </select>
        </div>
      </div>

      <label class="mt-4 flex w-fit cursor-pointer items-center gap-2 text-sm text-slate-300">
        <input
          id="solo-gratis"
          type="checkbox"
          class="h-4 w-4 rounded border-ink-600 bg-ink-950 accent-brand-400"
        />
        Solo con plan gratuito
      </label>
    </div>

    <p id="resultado-conteo" class="mt-6 text-sm text-slate-500" aria-live="polite"></p>

    <div id="lista-herramientas" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <div
            data-tool
            data-name={tool.data.name.toLowerCase()}
            data-search={`${tool.data.name} ${tool.data.tagline} ${tool.data.bestFor} ${tool.data.category}`.toLowerCase()}
            data-category={tool.data.category}
            data-rating={tool.data.rating}
            data-price={tool.data.pricing.from ?? 9999}
            data-free={String(tool.data.pricing.hasFreePlan)}
            data-date={tool.data.pubDate.toISOString()}
          >
            <ToolCard tool={tool} />
          </div>
        ))
      }
    </div>

    <p id="sin-resultados" hidden class="mt-10 rounded-xl border border-dashed border-ink-600 p-10 text-center text-slate-400">
      No hay ninguna herramienta con esos filtros. Prueba a quitar alguno.
    </p>

    <AdUnit adSlot="footer" minHeight={110} />
    <Newsletter />
  </div>

  <script is:inline>
  (() => {
    const list = document.getElementById('lista-herramientas');
    const cards = Array.from(document.querySelectorAll('[data-tool]'));
    const search = document.getElementById('buscador');
    const category = document.getElementById('filtro-categoria');
    const order = document.getElementById('orden');
    const onlyFree = document.getElementById('solo-gratis');
    const count = document.getElementById('resultado-conteo');
    const empty = document.getElementById('sin-resultados');

    const preset = new URLSearchParams(location.search).get('categoria');
    if (preset) category.value = preset;

    function apply() {
      const term = search.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matchesTerm = !term || card.dataset.search.includes(term);
        const matchesCategory = !category.value || card.dataset.category === category.value;
        const matchesFree = !onlyFree.checked || card.dataset.free === 'true';
        const show = matchesTerm && matchesCategory && matchesFree;
        card.hidden = !show;
        if (show) visible++;
      }

      const sorted = [...cards].sort((a, b) => {
        switch (order.value) {
          case 'price':
            return Number(a.dataset.price) - Number(b.dataset.price);
          case 'name':
            return a.dataset.name.localeCompare(b.dataset.name, 'es');
          case 'recent':
            return new Date(b.dataset.date) - new Date(a.dataset.date);
          default:
            return Number(b.dataset.rating) - Number(a.dataset.rating);
        }
      });
      sorted.forEach((card) => list.appendChild(card));

      count.textContent =
        visible === cards.length
          ? `${visible} herramientas`
          : `${visible} de ${cards.length} herramientas`;
      empty.hidden = visible !== 0;
    }

    [search, category, order, onlyFree].forEach((control) => {
      control.addEventListener('input', apply);
      control.addEventListener('change', apply);
    });

      apply();
    })();
  </script>
</BaseLayout>

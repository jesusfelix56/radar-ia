---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import ScoreBars from '../../components/ScoreBars.astro';
import AdUnit from '../../components/AdUnit.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import AmazonPicks from '../../components/AmazonPicks.astro';
import ToolCard from '../../components/ToolCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site } from '../../site.config';
import { formatDate, formatPrice } from '../../lib/format';
import { resolveToolCta, affiliateLinkAttrs, AFFILIATE_LABEL } from '../../lib/affiliates';
import TryButton from '../../components/TryButton.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { visualForTool, type ToolCategory } from '../../lib/visuals';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => !data.draft);
  return tools.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const { Content, headings } = await render(tool);
const data = tool.data;

const related = (await getCollection('tools', ({ data: other }) => !other.draft))
  .filter((other) => other.id !== tool.id)
  .sort((a, b) => {
    const aMatch = a.data.category === data.category ? 1 : 0;
    const bMatch = b.data.category === data.category ? 1 : 0;
    return bMatch - aMatch || b.data.rating - a.data.rating;
  })
  .slice(0, 3);

const price = data.pricing.hasFreePlan
  ? 'Tiene plan gratuito'
  : data.pricing.from !== null
    ? `${formatPrice(data.pricing.from, data.pricing.currency)}/${data.pricing.period}`
    : 'Precio a consultar';

const url = `${site.url}/herramientas/${tool.id}`;
const cta = resolveToolCta(tool);
const { href: ctaHref, isAffiliate } = cta;
const visual = visualForTool(tool.id, data.category as ToolCategory);

const schema = [
  {
    '@type': 'Review',
    '@id': `${url}#review`,
    url,
    name: `Análisis de ${data.name}`,
    headline: `Análisis de ${data.name}`,
    reviewBody: data.verdict,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: site.author },
    publisher: { '@id': `${site.url}/#organization` },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: data.rating,
      bestRating: 10,
      worstRating: 0,
    },
    itemReviewed: {
      '@type': 'SoftwareApplication',
      name: data.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: data.website,
      offers: {
        '@type': 'Offer',
        price: data.pricing.hasFreePlan ? 0 : (data.pricing.from ?? 0),
        priceCurrency: data.pricing.currency,
      },
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Herramientas', item: `${site.url}/herramientas` },
      { '@type': 'ListItem', position: 3, name: data.name, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${data.name}: análisis y opinión tras probarlo`}
  description={data.description}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
  schema={schema}
>
  <article class="container-page py-10">
    <Breadcrumbs
      items={[{ label: 'Herramientas', href: '/herramientas' }, { label: data.name }]}
    />

    <header class="mt-6 overflow-hidden rounded-3xl border border-ink-700">
      <div class="relative h-44 md:h-56">
        <img src={visual.cover} alt="" class="h-full w-full object-cover" width="1400" height="400" />
        <div
          class="absolute inset-0"
          style={`background: linear-gradient(90deg, #0b1220ee 10%, ${visual.color}55 100%)`}
        >
        </div>
        <div class="absolute inset-0 flex items-end p-6 md:p-8">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white p-2.5 shadow-xl md:h-20 md:w-20 md:p-3"
          >
            <ToolLogo id={tool.id} name={data.name} class="h-10 w-10 md:h-12 md:w-12" />
          </div>
        </div>
      </div>
      <div class="bg-ink-900/80 p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="rounded-full border border-ink-600 px-3 py-1 text-xs font-medium tracking-wide text-slate-400 uppercase"
          >
            {data.category}
          </span>
          <RatingBadge value={data.rating} size="sm" />
          <TryButton tool={tool} class="ml-auto" />
        </div>

        <h1 class="mt-4 font-display text-4xl font-bold text-white md:text-5xl">
          {data.name}
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">{data.tagline}</p>

        <p class="mt-5 text-xs text-slate-500">
          Publicado el {formatDate(data.pubDate)}
          {data.updatedDate && ` · Actualizado el ${formatDate(data.updatedDate)}`}
          · Por {site.author}
        </p>
      </div>
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        <section
          class="rounded-2xl border border-ink-700 bg-gradient-to-br from-ink-800/80 to-ink-900/60 p-6"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <h2 class="text-sm font-semibold tracking-wide text-emerald-400 uppercase">
                A favor
              </h2>
              <ul class="mt-3 space-y-2.5">
                {
                  data.pros.map((pro) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-slate-300">
                      <span class="mt-0.5 text-emerald-400" aria-hidden="true">
                        ✓
                      </span>
                      {pro}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h2 class="text-sm font-semibold tracking-wide text-rose-400 uppercase">En contra</h2>
              <ul class="mt-3 space-y-2.5">
                {
                  data.cons.map((con) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-slate-300">
                      <span class="mt-0.5 text-rose-400" aria-hidden="true">
                        ✕
                      </span>
                      {con}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <p class="mt-6 border-t border-ink-700 pt-5 text-sm text-slate-300">
            <strong class="text-white">Ideal para:</strong>{' '}
            {data.bestFor}
          </p>
        </section>

        <div
          data-article-body
          class="prose prose-invert prose-article mt-12 max-w-none prose-headings:text-white prose-a:text-brand-300 prose-strong:text-white"
        >
          <Content />
        </div>

        <InArticleAd />

        <section class="mt-12 rounded-2xl border border-brand-400/30 bg-brand-400/[0.07] p-6">
          <h2 class="font-display text-xl font-bold text-white">Veredicto</h2>
          <p class="mt-3 leading-relaxed text-slate-200">{data.verdict}</p>
          <div class="mt-5 flex flex-wrap items-center gap-4">
            <RatingBadge value={data.rating} size="lg" />
            <a
              href={ctaHref}
              rel={isAffiliate ? affiliateLinkAttrs.rel : 'noopener'}
              target="_blank"
              class="rounded-lg bg-brand-400 px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-brand-300"
            >
              Ir a la web de {data.name}
              {isAffiliate && (
                <span class="ml-1 opacity-80">({AFFILIATE_LABEL.toLowerCase()})</span>
              )}
            </a>
          </div>
        </section>

        {data.amazonPicks.length > 0 && <AmazonPicks picks={data.amazonPicks} />}

        <section class="mt-14">
          <h2 class="font-display text-2xl font-bold text-white">Alternativas que analizamos</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((other) => <ToolCard tool={other} />)}
          </div>
        </section>

        <div class="mt-14">
          <Newsletter compact />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl border border-ink-700 bg-ink-900/50 p-5">
          <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Puntuaciones</p>
          <div class="mt-4">
            <ScoreBars scores={data.scores} />
          </div>
          <div class="mt-5 border-t border-ink-700 pt-4">
            <p class="text-xs text-slate-500">Precio</p>
            <p class="mt-1 font-semibold text-white">{price}</p>
            {data.pricing.note && <p class="mt-2 text-xs leading-relaxed text-slate-500">{data.pricing.note}</p>}
          </div>
          <a
            href={ctaHref}
            rel={isAffiliate ? affiliateLinkAttrs.rel : 'noopener'}
            target="_blank"
            class="mt-5 block rounded-lg bg-brand-400 px-4 py-2.5 text-center text-sm font-semibold text-ink-950 transition hover:bg-brand-300"
          >
            Probar {data.name}
            {isAffiliate && (
              <span class="block text-[0.65rem] font-medium tracking-wide uppercase opacity-80">
                {AFFILIATE_LABEL}
              </span>
            )}
          </a>
        </div>

        <TableOfContents headings={headings} />

        <AdUnit adSlot="sidebar" format="rectangle" minHeight={250} class="my-0" />
      </aside>
    </div>
  </article>

  <script>
    // Marca el enlace del índice correspondiente a la sección visible.
  const links = document.querySelectorAll('nav[aria-label="Contenido"] a');
  if (links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            const active = link.getAttribute('href') === `#${entry.target.id}`;
            link.classList.toggle('text-brand-300', active);
            link.classList.toggle('text-slate-400', !active);
          });
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    document.querySelectorAll('[data-article-body] h2').forEach((heading) => observer.observe(heading));
  }
  </script>
</BaseLayout>

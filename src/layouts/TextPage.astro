---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
  heading?: string;
  intro?: string;
  updated?: string;
  noindex?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description,
  heading,
  intro,
  updated,
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="container-page max-w-3xl py-10">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

    <header class="mt-6 border-b border-ink-800 pb-8">
      <h1 class="font-display text-4xl font-bold text-white">{heading ?? title}</h1>
      {intro && <p class="mt-4 text-lg leading-relaxed text-slate-300">{intro}</p>}
      {updated && <p class="mt-4 text-xs text-slate-500">Última actualización: {formatDate(updated)}</p>}
    </header>

    <div
      class="prose prose-invert prose-article mt-10 max-w-none prose-headings:text-white prose-a:text-brand-300 prose-strong:text-white"
    >
      <slot />
    </div>
  </div>
</BaseLayout>

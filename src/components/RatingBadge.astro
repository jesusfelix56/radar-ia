---
interface Props {
  value: number;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { value, size = 'md', class: className = '' } = Astro.props;

const tone =
  value >= 8.5
    ? 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300'
    : value >= 7
      ? 'border-brand-400/40 bg-brand-400/10 text-brand-300'
      : value >= 5.5
        ? 'border-amber-400/40 bg-amber-400/10 text-amber-300'
        : 'border-rose-400/40 bg-rose-400/10 text-rose-300';

const sizes = {
  sm: 'text-xs px-2 py-0.5',
  md: 'text-sm px-2.5 py-1',
  lg: 'text-2xl px-4 py-2 font-display',
};
---

<span
  class={`inline-flex items-center gap-1 rounded-lg border font-semibold tabular-nums ${tone} ${sizes[size]} ${className}`}
  title={`Nota global: ${value.toFixed(1)} sobre 10`}
>
  {value.toFixed(1)}
  <span class="opacity-60">/10</span>
</span>

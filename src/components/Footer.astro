---
import { site } from '../site.config';
import AdUnit from './AdUnit.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Contenido',
    links: [
      { label: 'Todas las herramientas', href: '/herramientas' },
      { label: 'Comparativas', href: '/comparativas' },
      { label: 'Guías y tutoriales', href: '/guias' },
      { label: 'Recomendados en Amazon', href: '/recomendados' },
      { label: 'Generador de prompts', href: '/recursos/generador-de-prompts' },
    ],
  },
  {
    title: 'El proyecto',
    links: [
      { label: 'Cómo analizamos', href: '/metodologia' },
      { label: 'Sobre nosotros', href: '/sobre-nosotros' },
      { label: 'Contacto', href: '/contacto' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Aviso de afiliados', href: '/legal/afiliados' },
      { label: 'Privacidad', href: '/legal/privacidad' },
      { label: 'Cookies', href: '/legal/cookies' },
      { label: 'Aviso legal', href: '/legal/aviso-legal' },
    ],
  },
];
---

<footer class="no-print mt-24 border-t border-ink-800 bg-ink-900/40">
  <div class="container-page">
    <AdUnit adSlot="footer" minHeight={100} class="my-8" />
  </div>

  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <p class="font-display text-lg font-bold text-white">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-400">
        Probamos herramientas de inteligencia artificial con casos reales y publicamos lo que
        funciona, lo que no y cuánto cuesta de verdad.
      </p>
      <address class="mt-5 max-w-xs text-xs not-italic leading-relaxed text-slate-500">
        <p class="font-medium text-slate-400">{site.legalName}</p>
        <p>NIF {site.nif}</p>
        <p>{site.address}</p>
        <p class="mt-2">
          <a href={`mailto:${site.email}`} class="hover:text-brand-300">{site.email}</a>
        </p>
        <p class="mt-2">
          <a href="/legal/aviso-legal" class="underline hover:text-brand-300">Aviso legal</a>
        </p>
      </address>
    </div>

    {
      columns.map((column) => (
        <div>
          <p class="text-sm font-semibold text-white">{column.title}</p>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-400 transition hover:text-brand-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-ink-800">
    <div
      class="container-page flex flex-col gap-3 py-6 text-xs text-slate-500 md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} {site.legalName}. {site.name}.</p>
      <p class="max-w-2xl md:text-right">
        Los enlaces de compra de Amazon y de software están identificados como «enlace
        comisionado». En calidad de Afiliado de Amazon, obtenemos ingresos por las compras
        adscritas que cumplen los requisitos aplicables. ·{' '}
        <button type="button" data-open-consent class="underline hover:text-brand-300">
          Cambiar preferencias de cookies
        </button>
      </p>
    </div>
  </div>
</footer>

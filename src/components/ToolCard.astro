---
import type { CollectionEntry } from 'astro:content';
import RatingBadge from './RatingBadge.astro';
import TryButton from './TryButton.astro';
import ToolLogo from './ToolLogo.astro';
import { formatPrice } from '../lib/format';
import { visualForTool, type ToolCategory } from '../lib/visuals';

interface Props {
  tool: CollectionEntry<'tools'>;
  rank?: number;
}

const { tool, rank } = Astro.props;
const { name, tagline, category, rating, pricing } = tool.data;
const visual = visualForTool(tool.id, category as ToolCategory);

const price = pricing.hasFreePlan
  ? 'Plan gratuito'
  : pricing.from !== null
    ? `Desde ${formatPrice(pricing.from, pricing.currency)}/${pricing.period}`
    : 'Precio a consultar';
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-ink-700 bg-ink-900/80 shadow-lg shadow-black/20 transition hover:-translate-y-1 hover:border-white/20 hover:shadow-xl hover:shadow-black/40"
>
  {
    rank !== undefined && (
      <span class="absolute top-3 left-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/70 text-sm font-bold text-white backdrop-blur">
        {rank}
      </span>
    )
  }

  <div class="relative h-36 overflow-hidden">
    <img
      src={visual.cover}
      alt=""
      width="640"
      height="360"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute inset-0"
      style={`background: linear-gradient(180deg, ${visual.color}55 0%, #0a0f1ecc 100%)`}
    >
    </div>
    <div
      class="absolute right-4 bottom-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-white p-2 shadow-lg"
    >
      <ToolLogo id={tool.id} name={name} class="h-8 w-8" />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs tracking-wide text-slate-500 uppercase">{category}</p>
        <h3 class="mt-1 font-display text-lg leading-tight font-semibold text-white">
          <a href={`/herramientas/${tool.id}`} class="hover:text-brand-300">
            {name}
          </a>
        </h3>
      </div>
      <RatingBadge value={rating} size="sm" />
    </div>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{tagline}</p>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-ink-700 pt-4">
      <span class="text-xs font-medium text-slate-400">{price}</span>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`/herramientas/${tool.id}`}
          class="rounded-lg border border-ink-600 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:border-brand-400/60 hover:text-white"
        >
          Leer análisis
        </a>
        <TryButton tool={tool} label="Probar" class="px-3 py-2 text-xs" />
      </div>
    </div>
  </div>
</article>

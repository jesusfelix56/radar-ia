---
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import { resolveToolCta, AFFILIATE_LABEL, softwareAffiliateRel } from '../lib/affiliates';

interface Props {
  tool: {
    id: string;
    data: { website: string; affiliateUrl?: string; name: string };
  };
  label?: string;
  class?: string;
  /**
   * En tarjetas del ranking el botón queda en una sola línea, igual que «Leer análisis».
   * La etiqueta de afiliado y la divulgación las pinta la tarjeta debajo, a ancho completo,
   * para que no estiren ni recorten el botón.
   */
  compact?: boolean;
}

const { tool, label, class: className = '', compact = false } = Astro.props;
const cta = resolveToolCta(tool);
const buttonLabel = label ?? `Probar ${cta.name}`;
---

<span
  class:list={[
    'flex min-w-0 max-w-full flex-col gap-1.5',
    compact ? 'items-stretch' : 'inline-flex w-72 items-start',
  ]}
>
  <a
    href={cta.href}
    rel={cta.isAffiliate ? softwareAffiliateRel : 'noopener'}
    target="_blank"
    aria-label={cta.isAffiliate ? `${buttonLabel} (${AFFILIATE_LABEL})` : undefined}
    class:list={[
      'inline-flex w-fit items-center justify-center whitespace-nowrap rounded-lg bg-brand-400 px-4 py-2.5 text-sm font-semibold text-ink-950 transition hover:bg-brand-300',
      className,
    ]}
  >
    {buttonLabel}
  </a>
  {
    cta.isAffiliate && !compact && (
      <>
        <span class="text-[0.65rem] font-medium tracking-wide text-slate-400 uppercase">
          {AFFILIATE_LABEL}
        </span>
        <AffiliateDisclosure name={cta.name} />
      </>
    )
  }
</span>

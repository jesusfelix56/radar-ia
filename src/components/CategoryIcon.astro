---
interface Props {
  category: string;
  class?: string;
}

const { category, class: className = 'h-5 w-5' } = Astro.props;
---

<span class:list={['inline-flex', className]} aria-hidden="true">
  {
    category === 'Escritura' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3Z" stroke-linejoin="round" />
        <path d="m13.5 6.5 4 4" />
      </svg>
    )
  }
  {
    category === 'Imagen' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="8.5" cy="10" r="1.5" />
        <path d="m21 16-4.5-4.5L7 21" />
      </svg>
    )
  }
  {
    category === 'Vídeo' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="6" width="13" height="12" rx="2" />
        <path d="m16 10 5-3v10l-5-3v-4Z" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    category === 'Código' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="m8 8-4 4 4 4M16 8l4 4-4 4M13 6l-2 12" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    category === 'Audio' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="9" y="3" width="6" height="11" rx="3" />
        <path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke-linecap="round" />
      </svg>
    )
  }
  {
    category === 'Productividad' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="4" width="18" height="6" rx="1.5" />
        <rect x="3" y="14" width="8" height="6" rx="1.5" />
        <rect x="13" y="14" width="8" height="6" rx="1.5" />
      </svg>
    )
  }
  {
    category === 'Investigación' && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="11" cy="11" r="6.5" />
        <path d="m20 20-3.5-3.5" stroke-linecap="round" />
      </svg>
    )
  }
  {
    !['Escritura', 'Imagen', 'Vídeo', 'Código', 'Audio', 'Productividad', 'Investigación'].includes(category) && (
      <svg viewBox="0 0 24 24" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 6h16M4 12h10M4 18h13" stroke-linecap="round" />
      </svg>
    )
  }
</span>

---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---

{
  items.length > 2 && (
    <nav class="no-print rounded-xl border border-ink-700 bg-ink-900/50 p-5" aria-label="Contenido">
      <p class="text-xs font-semibold tracking-wide text-slate-400 uppercase">En este análisis</p>
      <ol class="mt-3 space-y-2 text-sm">
        {items.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="text-slate-400 transition hover:text-brand-300">
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

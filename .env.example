# Copia este archivo como `.env` y rellena tus datos reales.
# Todo lo que empieza por PUBLIC_ se incluye en el HTML final (es información pública, no secretos).

# Dominio definitivo del sitio, sin barra final. Se usa para canonicals, sitemap y RSS.
PUBLIC_SITE_URL=https://loprobamosai.es

# Google AdSense: tu ID de editor, con el prefijo ca-pub-
# Lo encuentras en AdSense > Cuenta > Información de la cuenta.
PUBLIC_ADSENSE_CLIENT=ca-pub-7494588122793199

# Pon esto a "true" cuando tengas IDs de bloque reales.
# adsbygoogle.js se carga igual (mensaje de consentimiento de Google).
# Mientras esté en false verás huecos reservados, sin unidades de anuncio.
PUBLIC_ADS_ENABLED=false

# IDs de bloque de anuncio (AdSense > Anuncios > Por unidad de anuncio).
PUBLIC_ADSENSE_SLOT_HEADER=1111111111
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=2222222222
PUBLIC_ADSENSE_SLOT_SIDEBAR=3333333333
PUBLIC_ADSENSE_SLOT_FOOTER=4444444444

# Amazon Afiliados: tu ID de seguimiento (Amazon Associates > Panel > Tus ID de seguimiento).
# Ejemplo español: mitienda-21
PUBLIC_AMAZON_TAG=loprobamos09-21

# Dominio de Amazon al que enviar el tráfico (amazon.es, amazon.com, amazon.com.mx...).
PUBLIC_AMAZON_DOMAIN=amazon.es

# Opcional. Endpoint de Formspree / Web3Forms / Netlify Forms para el formulario de contacto.
# Si lo dejas vacío, el formulario abre el cliente de correo del visitante.
PUBLIC_FORM_URL=

# Opcional. Endpoint de Buttondown / MailerLite / Beehiiv / Mailchimp para la newsletter.
# Si lo dejas vacío, la suscripción se envía por correo al titular.
PUBLIC_NEWSLETTER_URL=

# Opcional. Sustituye solo el href de ElevenLabs. Vacío = el enlace de PartnerStack
# definido en src/data/outbound-links.ts (affiliate: true).
# Perplexity, Copy.ai y Runway siguen con affiliate: false. No inventar parámetros.
PUBLIC_AFFILIATE_ELEVENLABS=
